PORT=4000
# Used to sign login tokens. Set a long random string in production.
JWT_SECRET=change-me
# Where the React app runs (CORS + Stripe redirect URLs).
CLIENT_URL=http://localhost:5173
# Optional. When set, checkout redirects to Stripe Checkout; otherwise the built-in demo card form is used.
STRIPE_SECRET_KEY=
# Optional. Defaults to server/data/ubankis.db
DB_PATH=
